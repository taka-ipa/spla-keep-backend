# 秘密情報はイメージに入れない（環境変数は実行時に渡す）
.env
.env.*
!.env.example

# 依存パッケージはイメージ内でcomposer installするので持ち込まない
vendor/
node_modules/

# バージョン管理・エディタ・Claude Codeの設定
.git/
.gitignore
.gitattributes
.idea/
.vscode/
.claude/
.DS_Store

# ローカル開発用のDB・ログ・キャッシュ
database/*.sqlite
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# テスト関連（本番イメージには不要）
tests/
phpunit.xml
.phpunit.result.cache

# Docker関連自体
Dockerfile
docker-compose*.yml
.dockerignore
