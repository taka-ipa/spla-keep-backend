# Docker Compose用のLaravel設定（backendコンテナだけに渡される）
# 使い方: cp .env.docker.example .env.docker して、APP_KEYとDB_PASSWORDを埋める
#   APP_KEY: docker compose run --rm backend php artisan key:generate --show
#   DB_PASSWORD: .env.docker.db の MYSQL_PASSWORD と必ず同じ値にする

APP_NAME="Spla Keep"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# コンテナのログ(docker compose logs)にLaravelのログを流す
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=spla_keep
DB_USERNAME=spla_keep
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
